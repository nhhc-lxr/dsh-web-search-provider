{
  "name": "dsh-web-tool-provider",
  "version": "0.11.1",
  "description": "Normalization layer for the Harness web seam: one provider in front of web_search and web_fetch that layers shared options over per-vendor settings for Tavily, Exa and Firecrawl.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*.png",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "icon": "icon.svg",
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "web-search",
    "web-fetch",
    "tavily",
    "exa",
    "firecrawl"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nhhc-lxr/dsh-web-tool-provider.git"
  },
  "bugs": {
    "url": "https://github.com/nhhc-lxr/dsh-web-tool-provider/issues"
  },
  "homepage": "https://github.com/nhhc-lxr/dsh-web-tool-provider#readme"
}
